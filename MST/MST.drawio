        </mxCell>
        <mxCell id="qgXxldIbosjhFXhmw3Tx-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Functional requrments:&lt;div&gt;user can register&lt;br&gt;&lt;div&gt;Message a number&lt;/div&gt;&lt;div&gt;chat in group&lt;/div&gt;&lt;div&gt;last seen&lt;/div&gt;&lt;div&gt;share file&lt;/div&gt;&lt;div&gt;message backup&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Non Functional requirments:&lt;/div&gt;&lt;div&gt;stable connection between users&lt;/div&gt;&lt;div&gt;low latency&lt;/div&gt;&lt;div&gt;avalability during connection setup&lt;/div&gt;&lt;div&gt;consistency after https handshake&lt;/div&gt;&lt;/div&gt;" vertex="1">
